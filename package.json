{
  "name": "hdm-wifi-billing-api",
  "version": "1.0.0",
  "description": "HDM Technologies WiFi Billing System — RADIUS, MikroTik, M-Pesa, and HDM Bridge integration",
  "main": "server.js",
  "author": "Davis Okoth",
  "license": "UNLICENSED",
  "private": true,
  "company": "HDM Technologies",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:schedulers": "node schedulers/index.js",
    "admin": "node scripts/admin.js",
    "seed": "node scripts/seed.js",
    "dns": "node scripts/dnsSet.js",
    "build": "npm --prefix client run build",
    "build:pwa": "npm --prefix client run pwa:assets && npm --prefix client run build",
    "start:prod": "npm run build:pwa && node server.js"
  },
  "keywords": [
    "wifi-billing",
    "radius",
    "freeradius",
    "mikrotik",
    "mpesa",
    "daraja",
    "hotspot",
    "isp"
  ],
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-routeros": "^1.6.8",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}